# ============================================
# .env.example - Plantilla de variables de entorno
# ============================================
# Copia este archivo como .env y completa los valores.
# cp .env.example .env
#
# ATENCION: .env NO se sube a Git (contiene credenciales)
#
# DATABASE_URL puede ser:
# - SQLite: desarrollo (sin internet, recomendado para dev)
# - PostgreSQL: produccion (Supabase)

# ============================================
# Configuracion de la app
# ============================================
APP_NAME="TrackFlow Inventory API"
CORS_ORIGINS="http://localhost:3000"

# ============================================
# Base de datos
# ============================================
# === Opcion 1: Desarrollo con SQLite ===
DATABASE_URL="sqlite+aiosqlite:///./dev.db"

# === Opcion 2: Produccion con PostgreSQL (descomenta y ajusta) ===
# DATABASE_URL="postgresql+asyncpg://usuario:password@host:5432/nombre_db"
