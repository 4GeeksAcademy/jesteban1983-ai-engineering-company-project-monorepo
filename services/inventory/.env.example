# ============================================
# .env.example - Plantilla de variables de entorno
# ============================================
# Copia este archivo como .env y completa los valores.
# cp .env.example .env
#
# ATENCION: .env NO se sube a Git (contiene credenciales)
#
# DATABASE_URL puede ser:
# - SQLite: desarrollo (sin internet, recomendado para dev)
# - PostgreSQL: produccion (Supabase o Docker local)
#
# DB_SSL_MODE: Solo aplica a PostgreSQL
#   "require"     → SSL obligatorio (Supabase, recomendado)
#   "prefer"      → SSL si el servidor lo soporta
#   "disable"     → Sin SSL (solo PostgreSQL local con Docker)
#   "verify-full" → SSL con verificación de certificado (más seguro)

# ============================================
# Configuracion de la app
# ============================================
APP_NAME="TrackFlow Inventory API"
CORS_ORIGINS="http://localhost:3000"

# ============================================
# Base de datos
# ============================================
# === Opcion 1: Desarrollo con SQLite ===
# No requiere instalacion, perfecto para desarrollo local
DATABASE_URL="sqlite+aiosqlite:///./dev.db"
# Para SQLite, DB_SSL_MODE se ignora automaticamente
DB_SSL_MODE="disable"

# === Opcion 2: PostgreSQL local con Docker ===
# docker compose up -d  (levanta PostgreSQL en puerto 5432)
# DATABASE_URL="postgresql+asyncpg://app:devpassword@localhost:5432/inventory"
# DB_SSL_MODE="disable"

# === Opcion 3: Produccion con Supabase (PostgreSQL en la nube) ===
# 1. Crea cuenta en https://supabase.com
# 2. Crea un proyecto y obten la conexion desde Settings -> Database
# 3. IMPORTANTE: Usa el puerto 5432 (no 6543) para asyncpg
# 4. La contrasena es la de tu proyecto Supabase
# DATABASE_URL="postgresql+asyncpg://postgres:TU_CONTRASENA@db.tuproyecto.supabase.co:5432/postgres"
# DB_SSL_MODE="require"
