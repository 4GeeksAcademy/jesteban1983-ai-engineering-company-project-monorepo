# ============================================
# .env.docker - services/inventory
# ============================================
# Configuración para ejecutar services/inventory dentro de Docker.
# PostgreSQL se conecta por nombre de servicio "postgres".
#
# Uso: docker compose --env-file services/inventory/.env.docker up -d
# ============================================

# --- Conexión a PostgreSQL via Docker ---
# El host "postgres" es el nombre del servicio en docker-compose.yml
DATABASE_URL=postgresql+asyncpg://app:devpassword@postgres:5432/inventory

# --- SSL desactivado (conexión interna Docker) ---
DB_SSL_MODE=disable

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002