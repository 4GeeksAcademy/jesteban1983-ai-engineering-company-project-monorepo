# ============================================
# .env.docker - services/api
# ============================================
# Configuración para ejecutar services/api dentro de Docker.
# Las variables se pasan via docker-compose.yml, pero puedes
# usar este archivo como referencia o con --env-file.
#
# Uso: docker compose --env-file services/api/.env.docker up -d

APP_NAME=TrackFlow API
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002